{
  "name": "momentum-screener",
  "version": "0.1.0",
  "private": true,
  "description": "Momentum-Screener mit Backtest auf Cloudflare Workers + D1 (Analyse-Tool, keine Anlageberatung, keine Order-Ausfuehrung).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/backtest.smoke.test.ts",
    "db:create": "wrangler d1 create momentum-screener-db",
    "db:migrate:local": "wrangler d1 migrations apply momentum-screener-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply momentum-screener-db --remote",
    "db:seed:local": "wrangler d1 execute momentum-screener-db --local --file=./scripts/seed-watchlist.sql",
    "db:seed:remote": "wrangler d1 execute momentum-screener-db --remote --file=./scripts/seed-watchlist.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.4.0"
  }
}
